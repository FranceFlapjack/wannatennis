# Copy to .env and fill in. NEVER paste these into a chat or commit them.
# LINE Developers Console -> your Messaging API channel:
#   Basic settings  -> Channel secret
#   Messaging API   -> Channel access token (long-lived) -> Issue
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# The bot's LINE ID, shown in LINE Official Account Manager (looks like @123abcd).
# Lets the website's "Alert me in LINE" button open the chat with the message ready.
LINE_BOT_BASIC_ID=

# The site's public https address (the tunnel URL). Lets "link" reply with a tap-to-open link.
PUBLIC_URL=

# Optional: force who gets health alerts (a LINE userId, starts with U...).
# Default: the first person who messages the bot.
ADMIN_LINE_USER_ID=

# Local testing without LINE: set only a made-up secret (e.g. dev-secret) and leave the
# token empty -> the bot runs in dry-run and writes every message to data/outbox.log.
# Try it with: node scripts/fake-line.js "alert sat 18-21 2h"
